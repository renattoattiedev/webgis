  DHS_INCLUSAO  DateTime @default(now())
  camada        Camadas  @relation(fields: [COD_CAMADA_ID], references: [COD_CAMADA_ID], onDelete: Cascade)
  grupo         Grupo    @relation(fields: [COD_GRUPO_ID], references: [COD_GRUPO_ID], onDelete: Cascade)

  @@id([COD_CAMADA_ID, COD_GRUPO_ID])
  @@map("TR_CAMADAS_GRUPOS_ADICIONAIS")
    @@schema("public")

}

