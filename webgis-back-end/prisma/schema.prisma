  COD_CAMADA_RASTER_ID String
  DSC_OPERACAO         String
  DSC_STATUS           String
  DSC_ERROR_MSG        String?       @db.VarChar(500)
  TXT_MUDANCAS         String?
  COD_USUARIO          String
  DHS_PUBLICACAO       DateTime      @default(now())
  camadasRaster        CamadasRaster @relation(fields: [COD_CAMADA_RASTER_ID], references: [COD_CAMADA_RASTER_ID])

