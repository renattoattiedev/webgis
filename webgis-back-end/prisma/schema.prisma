  COD_GRUPO_ID String
  DHS_INCLUSAO DateTime @default(now())
  mapa         Mapas    @relation(fields: [COD_MAPA_ID], references: [COD_MAPA_ID], onDelete: Cascade)
  grupo        Grupo    @relation(fields: [COD_GRUPO_ID], references: [COD_GRUPO_ID], onDelete: Cascade)

  @@id([COD_MAPA_ID, COD_GRUPO_ID])
  @@map("TR_MAPAS_GRUPOS_ADICIONAIS")
