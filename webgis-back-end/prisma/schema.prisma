  DHS_INCLUSAO         DateTime      @default(now())
  camadaRaster         CamadasRaster @relation(fields: [COD_CAMADA_RASTER_ID], references: [COD_CAMADA_RASTER_ID], onDelete: Cascade)
  grupo                Grupo         @relation(fields: [COD_GRUPO_ID], references: [COD_GRUPO_ID], onDelete: Cascade)

  @@id([COD_CAMADA_RASTER_ID, COD_GRUPO_ID])
  @@map("TR_CAMADAS_RASTER_GRUPOS_ADICIONAIS")
