model PublicacaoCamada {
  COD_PUBLICACAO_ID String   @id @default(uuid())
  COD_CAMADA_ID     String
  DSC_OPERACAO      String
  DSC_STATUS        String
  DSC_ERROR_MSG     String?  @db.VarChar(500)
  TXT_MUDANCAS      String?
