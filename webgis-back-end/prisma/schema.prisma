enum TipoPitometria {
  VAZAO
  PRESSAO

  @@schema("camadas")
}

model Pitometria {
  COD_PITOMETRIA_ID       String         @id @default(uuid())
  COD_SIMP                String
  MATRICULA               String
  TIPO                    TipoPitometria // Enum declarado no seu schema
  GEOMETRY                Unsupported("public.geometry(Point, 31983)")?
  COD_USUARIO_CRIACAO     String
  DHS_CRIACAO             DateTime       @default(now())
  COD_USUARIO_ATUALIZACAO String?
  DHS_ATUALIZACAO         DateTime?      @updatedAt
  DHS_EXCLUSAO            DateTime?

  @@map("TP_PITOMETRIA")
  @@schema("camadas")
}
